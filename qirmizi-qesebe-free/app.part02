0 ${slider.value}%)`}
    else els.beforeAfter.classList.add('hidden');
  }

  function renderMedia(r){const media=r?.media||[];els.mediaGrid.innerHTML=media.length?media.map(m=>{const u=safeUrl(m.url);if(m.type==='photo')return `<div class="mediaCard"><img src="${esc(u)}" alt="${esc(m.label||'Фото')}"><div><b>${esc(m.label||'Фото')}</b><small>${esc(m.year||'')} ${esc(m.source||'')}</small></div></div>`;if(m.type==='video')return `<div class="mediaCard"><video src="${esc(u)}" controls preload="metadata"></video><div><b>${esc(m.label||'Видео')}</b><small>${esc(m.year||'')}</small></div></div>`;return `<div class="mediaCard"><div><b>${esc(m.label||m.type)}</b><small><a href="${esc(u)}" target="_blank" rel="noreferrer">Открыть материал</a></small></div></div>`}).join(''):'<div class="sourceItem">Фото и видео пока не добавлены.</div>'}

  function renderViewer(r){const blocks=[];const pan=safeUrl(r?.panoramaUrl),model=safeUrl(r?.modelUrl);if(pan)blocks.push(`<div><b>360°-панорама</b><iframe src="${esc(pan)}" loading="lazy" referrerpolicy="no-referrer"></iframe></div>`);if(model)blocks.push(`<div><b>Детальная 3D-модель</b><model-viewer src="${esc(model)}" camera-controls auto-rotate shadow-intensity="1"></model-viewer></div>`);if(!blocks.length)blocks.push('<div class="sourceItem">Используется 3D-экструзия контура OSM. Ссылка на 360° или GLB/GLTF пока не добавлена.</div>');els.viewerArea.innerHTML=blocks.join('')}

  function renderSources(r){const sources=r?.sources||[];els.sourceList.innerHTML=sources.length?sources.map(s=>`<div class="sourceItem"><b>${esc(sourceTypeLabel(s.type))}: ${esc(s.label||'Источник')}</b><small>${esc(s.url||'')} · ${esc(s.note||'')}</small></div>`).join(''):'<div class="sourceItem">Источники пока не добавлены.</div>'}
  function renderVersions(r){const versions=r?.versions||[];els.versionList.innerHTML=versions.length?versions.slice().reverse().map(v=>`<div class="sourceItem"><b>${esc(new Date(v.at).toLocaleString('ru-RU'))}</b><small>${esc(v.summary||'Изменение записи')}</small></div>`).join(''):'<div class="sourceItem">Локальная история изменений появится после первого сохранения.</div>'}
  function sourceTypeLabel(t){return {official:'Официальный документ',archive:'Архив',publication:'Публикация',photo:'Фотография',video:'Видео',oral:'Устное свидетельство',unverified:'Не подтверждено'}[t]||t||'Источник'}

  function set3d(v){is3d=v;els.modeBtn.textContent=v?'3D':'2D';if(!map.getLayer('buildings-3d'))return;map.setLayoutProperty('buildings-3d','visibility',v?'visible':'none');map.setLayoutProperty('selected','visibility',v?'visible':'none');map.setLayoutProperty('buildings-2d','visibility',v?'none':'visible');map.easeTo({pitch:v?55:0,bearing:v?-18:0,duration:450})}

  function startWalk(){walk=true;els.intro.classList.add('hidden');els.walkHud.classList.remove('hidden');els.catalog.classList.add('hidden');els.passport.classList.add('hidden');set3d(true);map.dragPan.disable();map.touchZoomRotate.disable();map.easeTo({zoom:Math.max(map.getZoom(),20.1),pitch:80,duration:500});lastTime=performance.now();tick(lastTime)}
  function stopWalk(){walk=false;els.walkHud.classList.add('hidden');pressed.clear();cancelAnimationFrame(raf);map.dragPan.enable();map.touchZoomRotate.enable();map.easeTo({zoom:17.2,pitch:55,duration:450});els.catalog.classList.remove('hidden')}
  function tick(now){if(!walk)return;const dt=Math.min((now-lastTime)/1000,.05);lastTime=now;const f=(pressed.has('KeyW')||pressed.has('ArrowUp')||pressed.has('forward')?1:0)-(pressed.has('KeyS')||pressed.has('ArrowDown')||pressed.has('back')?1:0);const r=(pressed.has('KeyD')||pressed.has('ArrowRight')||pressed.has('right')?1:0)-(pressed.has('KeyA')||pressed.has('ArrowLeft')||pressed.has('left')?1:0);if(f||r){const c=map.getCenter(),br=map.getBearing()*Math.PI/180,spd=(pressed.has('ShiftLeft')||pressed.has('ShiftRight'))?6.5:2.8,dist=spd*dt,e=(Math.sin(br)*f+Math.cos(br)*r)*dist,n=(Math.cos(br)*f-Math.sin(br)*r)*dist,lat=Math.max(41.36,Math.min(41.3875,c.lat+n/110540)),lonScale=111320*Math.cos(c.lat*Math.PI/180),lon=Math.max(48.493,Math.min(48.529,c.lng+e/lonScale));map.jumpTo({center:[lon,lat]})}updateFrontTarget();drawMiniMap();raf=requestAnimationFrame(tick)}
  function updateFrontTarget(){if(!map.getLayer('buildings-3d'))return;const canvas=map.getCanvas(),pt=[canvas.clientWidth/2,canvas.clientHeight/2];const fs=map.queryRenderedFeatures(pt,{layers:[is3d?'buildings-3d':'buildings-2d']});const f=fs?.[0];if(f?.properties?.qqId){frontFeatureId=String(f.properties.qqId);const found=mergedFeatures().find(x=>x.properties.qqId===frontFeatureId);els.frontCard.querySelector('b').textContent=found?label(found):frontFeatureId;els.frontCard.querySelector('small').textContent=frontFeatureId;els.frontCard.classList.remove('hidden')}else{frontFeatureId=null;els.frontCard.classList.add('hidden')}}
  function drawMiniMap(){const cv=els.miniCanvas,ctx=cv.getContext('2d'),w=cv.width,h=cv.height;ctx.clearRect(0,0,w,h);ctx.fillStyle='#11161b';ctx.fillRect(0,0,w,h);const project=p=>[(p[0]-BOUNDS[0][0])/(BOUNDS[1][0]-BOUNDS[0][0])*w,h-(p[1]-BOUNDS[0][1])/(BOUNDS[1][1]-BOUNDS[0][1])*h];ctx.strokeStyle='#4b555e';ctx.lineWidth=1;for(const f of mergedFeatures().slice(0,1200)){const ring=f.geometry?.coordinates?.[0];if(!ring)continue;ctx.beginPath();ring.forEach((p,i)=>{const [x,y]=project(p);i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.stroke()}const c=project([map.getCenter().lng,map.getCenter().lat]);ctx.fillStyle='#ef7c62';ctx.beginPath();ctx.arc(c[0],c[1],4,0,Math.PI*2);ctx.fill();const br=(map.getBearing()-90)*Math.PI/180;ctx.strokeStyle='#ef7c62';ctx.beginPath();ctx.moveTo(c[0],c[1]);ctx.lineTo(c[0]+Math.cos(br)*16,c[1]+Math.sin(br)*16);ctx.stroke()}

  function openEditor(){const qq=selected?.properties?.qqId||els.editHouseLookup.value||'';els.editorModal.classList.remove('hidden');els.editorTitle.textContent=qq?`Редактирование ${qq}`:'Выберите дом на карте';els.editHouseLookup.value=qq;if(qq)fillEditor(qq)}
  function fillEditor(qq){const r=recordFor(qq)||{};els.editTitle.value=r.title||'';els.editDescription.value=r.description||'';els.editYear.value=r.year||'';els.editYearConfidence.value=r.yearConfidence||'unknown';els.editStatus.value=r.status||'existing';els.editVerification.value=r.verification||'open';els.editNote.value=r.note||'';els.edit360Url.value=r.panoramaUrl||'';els.editModelUrl.value=r.modelUrl||'';els.editAudioUrl.value=r.audioUrl||''}

  function saveEditorRecord(){const qq=(els.editHouseLookup.value||selected?.properties?.qqId||'').trim();if(!qq){alert('Сначала выберите дом или укажите QQ-ID');return}const prev=recordFor(qq)||{media:[],sources:[],versions:[],issues:[]};const next={...prev,title:els.editTitle.value.trim(),description:els.editDescription.value.trim(),year:Number(els.editYear.value)||null,yearConfidence:els.editYearConfidence.value,status:els.editStatus.value,verification:els.editVerification.value,note:els.editNote.value.trim(),panoramaUrl:safeUrl(els.edit360Url.value),modelUrl:safeUrl(els.editModelUrl.value),audioUrl:safeUrl(els.editAudioUrl.value),updatedAt:nowIso()};
    const su=safeUrl(els.editSourceUrl.value);if(su||els.editSourceLabel.value.trim())next.sources=[...(next.sources||[]),{type:els.editSourceType.value,url:su,label:els.editSourceLabel.value.trim(),note:els.editNote.value.trim(),at:nowIso()}];
    const media=[];const photo=safeUrl(els.editPhotoUrl.value),video=safeUrl(els.editVideoUrl.value);if(photo)media.push({type:'photo',url:photo,year:Number(els.editPhotoYear.value)||null,label:els.editSourceLabel.value.trim()||'Фото',source:su||'',at:nowIso()});if(video