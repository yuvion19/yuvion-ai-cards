)media.push({type:'video',url:video,year:Number(els.editPhotoYear.value)||null,label:els.editSourceLabel.value.trim()||'Видео',source:su||'',at:nowIso()});next.media=[...(next.media||[]),...media];next.versions=[...(next.versions||[]),{at:nowIso(),summary:`Сохранено: ${next.title||qq}`}];store.records[qq]=next;saveStore();els.editorModal.classList.add('hidden');selectByQQ(qq,false)}

  function addMediaFromEditor(){const qq=(els.editHouseLookup.value||selected?.properties?.qqId||'').trim();if(!qq)return alert('Выберите дом');const r=recordFor(qq)||{media:[],sources:[],versions:[],issues:[]};const urls=[['photo',els.editPhotoUrl.value],['video',els.editVideoUrl.value]].filter(([,u])=>safeUrl(u));if(!urls.length)return alert('Укажите URL фото или видео');for(const [type,url] of urls)r.media.push({type,url:safeUrl(url),year:Number(els.editPhotoYear.value)||null,label:els.editSourceLabel.value.trim()||type,source:safeUrl(els.editSourceUrl.value),at:nowIso()});r.versions.push({at:nowIso(),summary:'Добавлен медиа-материал'});store.records[qq]=r;saveStore();fillEditor(qq)}
  function markIssue(){const qq=(els.editHouseLookup.value||selected?.properties?.qqId||'').trim();if(!qq)return alert('Выберите дом');const r=recordFor(qq)||{media:[],sources:[],versions:[],issues:[]};r.issues=[...(r.issues||[]),{text:'Требуется проверка контура/положения здания',at:nowIso()}];r.versions=[...(r.versions||[]),{at:nowIso(),summary:'Отмечена проблема геометрии'}];store.records[qq]=r;saveStore()}
  function deleteLocal(){const qq=(els.editHouseLookup.value||selected?.properties?.qqId||'').trim();if(!qq||!store.records[qq])return;delete store.records[qq];saveStore();fillEditor(qq)}

  async function fileToDataUrl(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(String(r.result));r.onerror=rej;r.readAsDataURL(file)})}
  function nearestBuilding(lon,lat,max=100){let best=null,dist=Infinity;for(const f of data?.features||[]){const d=distanceMeters([lon,lat],centerOf(f));if(d<dist){dist=d;best=f}}return dist<=max?best:null}
  async function guessHouseForFile(file){const fromName=houseIdFromFilename(file.name);if(fromName&&mergedFeatures().some(f=>f.properties.qqId===fromName))return fromName;try{if(window.exifr&&file.type.startsWith('image/')){const ex=await exifr.parse(file,['latitude','longitude','GPSLatitude','GPSLongitude']);const lat=ex?.latitude,lon=ex?.longitude;if(Number.isFinite(lat)&&Number.isFinite(lon)){const n=nearestBuilding(lon,lat,120);if(n)return n.properties.qqId}}}catch{}return selected?.properties?.qqId||null}

  async function batchImport(){const files=[...els.batchInput.files];if(!files.length)return;let imported=0,unmatched=0;for(const file of files){try{
      if(/\.json$|\.geojson$/i.test(file.name)){const obj=JSON.parse(await file.text());if(obj.type==='FeatureCollection'&&Array.isArray(obj.features)){for(const f of obj.features){const qq=f.properties?.qqId||f.properties?.id||`QQ-CUSTOM-${Date.now()}-${imported}`;f.properties={...(f.properties||{}),qqId:qq,renderHeight:Number(f.properties?.renderHeight)||7,heightEstimated:true,userStatus:f.properties?.status||'lost'};store.customFeatures.push(f);imported++}}else if(obj.records){Object.assign(store.records,obj.records);if(obj.customFeatures)store.customFeatures.push(...obj.customFeatures);imported+=Object.keys(obj.records).length}else if(Array.isArray(obj)){for(const row of obj){const qq=row.qqId||row.qq_id;if(!qq)continue;store.records[qq]={...(store.records[qq]||{}),...row,versions:[...(store.records[qq]?.versions||[]),{at:nowIso(),summary:'Пакетный импорт JSON'}]};imported++}}}
      else if(/\.csv$/i.test(file.name)){const lines=(await file.text()).split(/\r?\n/).filter(Boolean),headers=lines.shift().split(',').map(x=>x.trim());for(const line of lines){const vals=line.split(',');const row=Object.fromEntries(headers.map((h,i)=>[h,vals[i]?.trim()]));const qq=row.qqId||row.qq_id||row.id;if(!qq)continue;store.records[qq]={...(store.records[qq]||{}),title:row.title||row.name||'',description:row.description||'',year:Number(row.year)||null,status:row.status||'existing',verification:row.verification||'materials',media:store.records[qq]?.media||[],sources:store.records[qq]?.sources||[],versions:[...(store.records[qq]?.versions||[]),{at:nowIso(),summary:'Пакетный импорт CSV'}],issues:store.records[qq]?.issues||[]};imported++}}
      else if(/\.zip$/i.test(file.name)&&window.JSZip){const zip=await JSZip.loadAsync(file);for(const [name,entry] of Object.entries(zip.files)){if(entry.dir||!(/\.(jpg|jpeg|png|webp)$/i.test(name)))continue;const qq=houseIdFromFilename(name)||selected?.properties?.qqId;if(!qq){unmatched++;continue}const blob=await entry.async('blob');if(blob.size>MAX_INLINE_FILE){unmatched++;continue}const dataUrl=await fileToDataUrl(new File([blob],name,{type:blob.type||'image/jpeg'}));const r=recordFor(qq)||{media:[],sources:[],versions:[],issues:[]};r.media.push({type:'photo',url:dataUrl,label:name,year:null,source:'ZIP import',at:nowIso()});r.versions.push({at:nowIso(),summary:`Импорт фото ${name}`});store.records[qq]=r;imported++}}
      else if(file.type.startsWith('image/')||file.type.startsWith('video/')){const qq=await guessHouseForFile(file);if(!qq||file.size>MAX_INLINE_FILE){unmatched++;continue}const dataUrl=await fileToDataUrl(file);const r=recordFor(qq)||{media:[],sources:[],versions:[],issues:[]};r.media.push({type:file.type.startsWith('video/')?'video':'photo',url:dataUrl,label:file.name,year:null,source:'Локальный импорт',at:nowIso()});r.versions.push({at:nowIso(),summary:`Автосопоставление файла ${file.name}`});store.records[qq]=r;imported++}
    }catch(e){console.error(e);unmatched++}}
    saveStore();els.batchResult.textContent=`Импортировано: ${imported}. Не сопоставлено/слишком крупно: ${unmatched}. Для файлов > ${Math.round(MAX_INLINE_FILE/1000)} КБ лучше использовать URL.`
  }

  function updateStats(){const fs=mergedFeatures();const total=fs.length,withRec=fs.filter(f=>recordFor(f.properties.qqId)).length,photo=fs.filter(f=>recordFor(f.properties.qqId)?.media?.some(m=>m.type==='photo')).length,pan=fs.filter(f=>recordFor(f.properties.qqId)?.panoramaUrl).length,model=fs.filter(f=>recordFor(f.properties.qqId)?.modelUrl).length,complete=fs.filter(f=>completeness(f)>=70).length,issues=fs.filter(f=>qualityIssues(f).length).length,pct=total?Math.round(complete/total*100):0;els.statsGrid.innerHTML=[['Всего объектов',total],['Есть сведения',withRec],['Есть фото',photo],['Есть 360°',pan],['Есть 3D-модель',model],['Оцифровано ≥70%',complete]].map(([k,v])=>`<div><b>${v}</b><span>${k}</span></div>`).join('');els.coverageBar.querySelector('span').style.width=`${pct}%`;els.qualitySummary.innerHTML=`<div class="sourceItem"><b>${pct}% объектов достигли уровня 70%+</b><small>${issues} объектов имеют предупреждения качества. Серый/красный/золотой режим можно включить в «Слои».</small></div>`}

  function makeHeritageRoute(){const fs=mergedFeatures().filter(isHeritage).slice(0,20);currentRoute=fs.map(f=>f.properties.qqId);routeIndex=0;renderRoutes();drawRoute()}
  function renderRoutes(){const saved=store.routes||[];els.routeList.innerHTML=`<div class="routeItem"><b>Исторические и общественные объекты</b><small>${currentRoute.length||mergedFeatures().filter(isHeritage).length} точек · формируется из реальных тегов OSM</small><button id="activateHeritage">Построить маршрут</button></div>`+saved.map((r,i)=>`<div class="routeItem"><b>${esc(r.title||`Маршрут ${i+1}`)}</b><small>${r.points?.length||0} точек</small></div>`).join('');const b=document.getElementById('activateHeritage');if(b)b.onclick=makeHeritageRoute;if(currentRoute.length){els.tourControls.classList.remove('hidden');els.tourTitle.textContent='Исторический маршрут';updateTourLabel()}else els.tourControls.classList.add('hidden')}
